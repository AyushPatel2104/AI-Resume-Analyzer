# Copy to backend/.env (or set in your host environment)

DATABASE_URL=sqlite:///./data/resume_analyzer.db
# Production / Docker PostgreSQL example (set your own credentials):
# DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@HOST:5432/DATABASE

# Comma-separated browser origins allowed to call the API (required in production)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

MAX_UPLOAD_BYTES=5242880
ALLOWED_EXTENSIONS=.pdf,.docx
UPLOAD_DIR=./data/uploads
DEBUG=false

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1
