# Copy to backend/.env — never commit real secrets.

# --- Required in production (DEBUG=false) ---
DEBUG=false
JWT_SECRET_KEY=
# Comma-separated frontend origins (no wildcards in production)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Database ---
# Development default:
DATABASE_URL=sqlite:///./data/resume_analyzer.db
# Production PostgreSQL example (use your provider's URL):
# DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@HOST:5432/DATABASE

JWT_ACCESS_TOKEN_EXPIRE_MINUTES=10080
PORT=8000
LOG_LEVEL=INFO

# --- Uploads / storage ---
MAX_UPLOAD_BYTES=5242880
ALLOWED_EXTENSIONS=.pdf,.docx
UPLOAD_DIR=./data/uploads
# local = dev/ephemeral hosts only; durable object storage requires a future provider plugin
STORAGE_BACKEND=local

# --- Rate limiting (single-instance; see docs/PRODUCTION.md) ---
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH_PER_MINUTE=20
RATE_LIMIT_UPLOAD_PER_MINUTE=15
RATE_LIMIT_ANALYZE_PER_MINUTE=20
RATE_LIMIT_JOB_IMPORT_PER_MINUTE=10
RATE_LIMIT_CAREER_ASSISTANT_PER_MINUTE=40

# --- Optional AI (backend only — never NEXT_PUBLIC_*) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

SEMANTIC_MODEL_ENABLED=false
