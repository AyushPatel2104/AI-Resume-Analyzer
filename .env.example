# Copy to `.env` in the repo root for Docker Compose (`.env` is gitignored).
# Use your own local values — do not commit real production credentials.

# --- Docker Compose / PostgreSQL (local) ---
POSTGRES_USER=your_postgres_user
POSTGRES_PASSWORD=your_local_postgres_password
POSTGRES_DB=resume_analyzer

# Optional: override full backend URL (otherwise derived from Postgres vars above)
# DATABASE_URL=postgresql+psycopg2://your_postgres_user:your_local_postgres_password@db:5432/resume_analyzer

# --- Backend (when running outside Compose: copy backend/.env.example → backend/.env) ---
# DATABASE_URL=sqlite:///./data/resume_analyzer.db
# CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# DEBUG=false
# JWT_SECRET_KEY=your-long-random-secret-at-least-32-characters
# OPENAI_API_KEY=

# --- Frontend (copy frontend/.env.example → frontend/.env.local) ---
# NEXT_PUBLIC_API_URL=http://localhost:8000

# Production: set CORS_ORIGINS and NEXT_PUBLIC_API_URL to your deployed origins (no secrets in NEXT_PUBLIC_*).
